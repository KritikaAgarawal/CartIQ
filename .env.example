# This is a template for the environment variables required by the project.
# Copy this file to '.env', fill in your real values, and keep it secure.
# The actual '.env' file is git-ignored and should never be committed to version control.

GOOGLE_APPLICATION_CREDENTIALS=credentials/your-service-account.json
GCP_PROJECT_ID=your-gcp-project-id
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cartiq
DB_USER=postgres
DB_PASSWORD=your_postgres_password
